# CloudBase 环境变量（复制为 .env 并填写）
#
# ⚠️ .env 不要提交到 Git！已在 .gitignore 中排除

# ── 数据源 ──
# local = localStorage（默认，单机演示）
# cloud = CloudBase PostgreSQL（多人联机）
VITE_DATA_SOURCE=local

# ── CloudBase 配置 ──
# 环境 ID，控制台可见
VITE_CLOUDBASE_ENV_ID=see-boss-d2gjggfbz8808d1d4

# Publishable Key：可安全暴露在前端（role=anon，受 RLS 约束）
# 在「云开发平台 → 设置 → API Key」生成，只能生成一次，请妥善保存
# ⚠️ 绝不要用 API Key（service_role 有 BYPASSRLS，等于数据全裸）
VITE_CLOUDBASE_PUBLISHABLE_KEY=

# 地域：上海 ap-shanghai / 新加坡 ap-singapore
VITE_CLOUDBASE_REGION=ap-shanghai

# ── 实时同步策略 ──
# cdc       = Postgres CDC（需实测可用性）
# broadcast = 内存消息通道（不消耗资源点，需服务端配合）
# poll      = 轮询（默认，最稳）
VITE_REALTIME_MODE=poll
